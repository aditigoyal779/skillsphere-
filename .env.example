# Copy to .env (or export these) -- all optional for local development
SKILLSPHERE_ENV=development
# Required in production: long random string
SKILLSPHERE_SECRET_KEY=change-me
SKILLSPHERE_ADMIN_EMAIL=
SKILLSPHERE_ADMIN_PASSWORD=
SKILLSPHERE_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional email (needed in production)
SKILLSPHERE_SMTP_HOST=
SKILLSPHERE_SMTP_PORT=587
SKILLSPHERE_SMTP_USERNAME=
SKILLSPHERE_SMTP_PASSWORD=
SKILLSPHERE_SMTP_FROM=
# Optional video storage (falls back to data/recordings/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
